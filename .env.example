# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a git.

# Conexión a PostgreSQL (Supabase).
# En Supabase: Project Settings > Database > Connection string > "Session pooler" (puerto 5432).
# No uses el "Transaction pooler" (6543): no soporta todo lo que usa el backend.
DATABASE_URL=postgresql://postgres.tu-proyecto:tu-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar las sesiones. Genera una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del backend. Vite redirige /api a este puerto.
API_PORT=3001

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:8443
